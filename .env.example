# Copy this file to .env and fill in your own keys.
# Vayum never hardcodes secrets in source code.

# https://www.weatherapi.com/  (free tier is enough)
WEATHER_API_KEY=your_weatherapi_key_here

# https://docs.openaq.org/ (OpenAQ v3 requires a free API key)
OPENAQ_API_KEY=your_openaq_key_here

# Flask session secret (any random string)
SECRET_KEY=vayum-college-project-secret-key

# How long cached readings stay "fresh" before we call the APIs again (minutes)
AIR_QUALITY_CACHE_MINUTES=60
WEATHER_CACHE_MINUTES=120
